#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/lib.sh"

failures=0
check() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf '[OK] %s\n' "${label}"
  else
    printf '[失败] %s\n' "${label}"
    failures=$((failures + 1))
  fi
}

ensure_env
load_env
check "Docker CLI" command -v docker
check "Docker Engine" docker info
check "Docker Compose" docker compose version
check "curl 更新查询" command -v curl
check "jq 更新查询" command -v jq
check "Compose 配置" dc_all config --quiet
if [[ $(stat -c '%a' "${ROOT_DIR}/config/mysql/my.cnf") =~ [2367]$ ]]; then
  printf '[失败] MySQL 配置允许所有用户写入，会被 MySQL 忽略；请重新安装。\n'
  failures=$((failures + 1))
else
  printf '[OK] MySQL 配置权限\n'
fi

for port in \
  "${MYSQL_PORT}" "${POSTGRES_PORT}" "${REDIS_PORT}" "${KAFKA_PORT}" \
  "${S3_PORT}" "${S3_ADMIN_PORT}" "${MAILPIT_SMTP_PORT}" "${MAILPIT_UI_PORT}"; do
  if [[ "${port}" =~ ^2[0-9]{4}$ ]]; then
    printf '[OK] 宿主端口 %s 位于 2xxxx 范围\n' "${port}"
  else
    printf '[失败] 宿主端口 %s 不在 2xxxx 范围\n' "${port}"
    failures=$((failures + 1))
  fi
done

if ((failures)); then
  echo "诊断发现 ${failures} 个问题。" >&2
  exit 1
fi
echo "dev-infra 配置正常。"
