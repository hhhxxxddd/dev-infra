#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/lib.sh"

load_env
require_docker

service="${1:-}"
confirm="${2:-}"
[[ -n "${service}" ]] || {
  echo "用法：dev-infra reset <mysql|postgres|redis|kafka|s3|mailpit> [--yes]" >&2
  exit 2
}
service_is_known "${service}" || {
  echo "未知服务：${service}" >&2
  exit 2
}

case "${service}" in
  mysql) volume="${MYSQL_DATA_VOLUME}" ;;
  postgres) volume="${POSTGRES_DATA_VOLUME}" ;;
  redis) volume="${REDIS_DATA_VOLUME}" ;;
  kafka) volume="${KAFKA_DATA_VOLUME}" ;;
  s3) volume="${S3_DATA_VOLUME}" ;;
  mailpit) volume="${MAILPIT_DATA_VOLUME}" ;;
esac

if [[ "${confirm}" != "--yes" ]]; then
  read -r -p "删除 ${service} 数据卷 ${volume} 并重新创建？[y/N] " answer
  [[ "${answer}" == y || "${answer}" == Y ]] || exit 0
fi

dc stop "${service}" >/dev/null 2>&1 || true
if [[ "${service}" == s3 ]]; then
  dc rm -f s3 s3-permissions >/dev/null 2>&1 || true
else
  dc rm -f "${service}" >/dev/null 2>&1 || true
fi
docker volume inspect "${volume}" >/dev/null 2>&1 && docker volume rm "${volume}"
ensure_volumes "${service}"
dc up -d --wait --wait-timeout 240 "${service}"
ensure_s3_bucket "${service}"
dc ps --all "${service}"
