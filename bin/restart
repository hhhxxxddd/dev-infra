#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/lib.sh"

load_env
require_docker
targets=()
resolve_services targets "$@"
ensure_volumes "${targets[@]}"
dc up -d --force-recreate --wait --wait-timeout 240 "${targets[@]}"
ensure_s3_bucket "${targets[@]}"
print_service_table "${targets[@]}"
