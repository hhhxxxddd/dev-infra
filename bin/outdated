#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/lib.sh"

as_json=false
requested=()
for argument in "$@"; do
  case "${argument}" in
    --json) as_json=true ;;
    --*) echo "未知选项：${argument}" >&2; exit 2 ;;
    *) requested+=("${argument}") ;;
  esac
done

load_env --read-only
require_docker
for dependency in curl jq; do
  command -v "${dependency}" >/dev/null 2>&1 || {
    echo "更新查询需要 ${dependency}，请安装 curl 和 jq。" >&2
    exit 1
  }
done
targets=()
resolve_services targets "${requested[@]}"
service_requested s3 "${targets[@]}" && targets+=(s3-client)
compose_config=$(dc_all config --format json)

latest_tag() {
  local repository="$1" scope="$2" alias="$3" page=1 payload matches candidates='[]' name release_digest
  payload=$(curl --fail --silent --show-error --connect-timeout 5 --max-time 20 \
    "https://hub.docker.com/v2/repositories/${repository}/tags/${alias}") || return 1
  release_digest=$(jq -er '.digest | select(test("^sha256:[0-9a-f]{64}$"))' <<<"${payload}") || return 1
  while ((page <= 10)); do
    payload=$(curl --fail --silent --show-error --connect-timeout 5 --max-time 20 \
      "https://hub.docker.com/v2/repositories/${repository}/tags?page_size=100&name=${scope}&page=${page}") || return 1
    matches=$(jq -ce --arg scope "${scope}" '
      .results | if type != "array" then error("标签列表无效") else . end |
      map(select(.name | test("^v?[0-9]+(\\.[0-9]+){1,2}$"))) |
      map(select(.name == $scope or (.name | startswith($scope + ".")))) |
      map({name, digest, images: [.images[]? | {digest}]})
    ' <<<"${payload}") || return 1
    candidates=$(printf '%s\n%s\n' "${candidates}" "${matches}" | jq -cs 'add') || return 1
    if jq -e --arg digest "${release_digest}" 'any(.digest == $digest)' <<<"${candidates}" >/dev/null; then
      candidates=$(jq -c --arg digest "${release_digest}" 'map(select(.digest == $digest))' <<<"${candidates}")
      break
    fi
    [[ $(jq -r '.next // empty' <<<"${payload}") ]] || break
    page=$((page + 1))
  done
  ((page <= 10)) || { echo "${repository} 标签分页超过查询限制，结果不完整。" >&2; return 1; }
  name=$(jq -r '.[].name' <<<"${candidates}" | sort -V | tail -n 1)
  [[ -n "${name}" ]] || { echo "${repository} 未找到 ${scope} 分支的稳定版本。" >&2; return 1; }
  jq -ce --arg name "${name}" '[.[] | select(.name == $name)][0] | select(.digest | test("^sha256:[0-9a-f]{64}$"))' <<<"${candidates}"
}

records=()
failures=0
if [[ "${as_json}" == false ]]; then
  printf '%-12s %-34s %-34s %s\n' "服务" "配置镜像" "最新稳定镜像" "状态"
fi
for service in "${targets[@]}"; do
  image=$(jq -er --arg service "${service}" '.services[$service].image' <<<"${compose_config}")
  repository="${image%:*}"
  [[ "${repository}" == */* ]] || repository="library/${repository}"
  configured="${image##*:}"
  case "${service}" in
    mysql|s3-client) scope=$(cut -d . -f 1,2 <<<"${configured}") ;;
    *) scope="${configured%%.*}" ;;
  esac
  case "${service}" in
    mysql|postgres|redis|mailpit) alias="${scope}" ;;
    *) alias=latest ;;
  esac
  status=error
  latest=''
  if metadata=$(latest_tag "${repository}" "${scope}" "${alias}"); then
    tag=$(jq -r '.name' <<<"${metadata}")
    latest="${image%:*}:${tag}"
    container=$(dc ps --all -q "${service}" | head -n 1)
    local_image="${image}"
    if [[ -n "${container}" ]]; then
      local_image=$(docker inspect --format '{{.Image}}' "${container}")
    fi
    if local_metadata=$(docker image inspect "${local_image}" 2>/dev/null); then
      local_digests=$(jq -c '[.[0].RepoDigests[]? | split("@")[1]]' <<<"${local_metadata}")
      if jq -e --argjson local "${local_digests}" '
        [.digest, .images[]?.digest] | any(. as $digest | $local | index($digest))
      ' <<<"${metadata}" >/dev/null; then
        status=current
      else
        status=update_available
      fi
    else
      status=not_downloaded
    fi
  else
    failures=$((failures + 1))
  fi
  records+=("$(jq -cn --arg service "${service}" --arg configured "${image}" \
    --arg latest "${latest}" --arg status "${status}" \
    '{service: $service, configured: $configured, latest: $latest, status: $status}')")
  if [[ "${as_json}" == false ]]; then
    case "${status}" in
      current) description=最新 ;;
      update_available) description=可更新 ;;
      not_downloaded) description=未下载 ;;
      error) description=查询失败 ;;
    esac
    printf '%-12s %-34s %-34s %s\n' "${service}" "${image}" "${latest:--}" "${description}"
  fi
done
if [[ "${as_json}" == true ]]; then
  printf '%s\n' "${records[@]}" | jq -s --argjson complete "$([[ "${failures}" == 0 ]] && echo true || echo false)" \
    '{complete: $complete, images: .}'
fi
((failures == 0))
