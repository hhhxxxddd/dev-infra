#!/usr/bin/env bash
set -Eeuo pipefail
ROOT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export PYTHONPATH="${ROOT_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
if [[ -f "${ROOT_DIR}/.python" ]]; then
  IFS= read -r python_path <"${ROOT_DIR}/.python"
else
  python_path="${DEV_INFRA_PYTHON:-python3.14}"
fi
exec "${python_path}" -m dev_infra "$@"
